{
  "expo": {
    "name": "AM Mart",
    "slug": "am-mart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#183522",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ammart.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AM Mart uses your location to find nearby stores and track deliveries.",
        "NSCameraUsageDescription": "AM Mart needs camera access to upload documents.",
        "NSPhotoLibraryUsageDescription": "AM Mart needs photo library access to upload images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.ammart.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "scheme": "ammart",
    "updates": {
      "url": "https://u.expo.dev/afdc9d1a-7bc8-42e1-b40d-cd8a57079f61",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61"
      }
    }
  }
}