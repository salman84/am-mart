{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:device": "expo run:android --device",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:apk": "eas build --profile production-apk --platform android",
    "build:aab": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:prod": "eas update --branch production",
    "assets": "node scripts/generate-assets.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ngrok": "^4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.0",
    "@reduxjs/toolkit": "^2.2.5",
    "@stripe/stripe-react-native": "0.38.6",
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "expo": "~52.0.49",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.2",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "lottie-react-native": "7.1.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-country-picker-modal": "2.0.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "1.18.0",
    "react-native-modal": "^13.0.1",
    "react-native-otp-entry": "^1.7.1",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-star-rating-widget": "^1.8.0",
    "react-native-svg": "15.8.0",
    "react-native-svg-transformer": "^1.3.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-webview": "13.12.5",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "@types/react-native": "~0.73.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.3.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-native-web",
        "react-dom",
        "@babel/preset-env"
      ],
      "allowedVersions": {
        "react": "18",
        "react-native": "0.74"
      }
    },
    "overrides": {
      "react-native-maps": "1.14.0"
    }
  }
}
