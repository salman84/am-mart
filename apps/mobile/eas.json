{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EAS_PROJECT_ID": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "EAS_PROJECT_ID": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release",
        "distribution": "internal"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EAS_PROJECT_ID": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61",
        "EXPO_PUBLIC_API_URL": "https://ammart-api.onrender.com/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release",
        "distribution": "store"
      }
    },
    "production-apk": {
      "extends": "production",
      "env": {
        "APP_ENV": "production",
        "EAS_PROJECT_ID": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61",
        "EXPO_PUBLIC_API_URL": "https://ammart-api.onrender.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "live": {
      "distribution": "internal",
      "channel": "live",
      "env": {
        "APP_ENV": "production",
        "EAS_PROJECT_ID": "afdc9d1a-7bc8-42e1-b40d-cd8a57079f61",
        "EXPO_PUBLIC_API_URL": "https://ammart-api.onrender.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your@apple.id",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
