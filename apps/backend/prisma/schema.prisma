generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  email             String?    @unique
  phone             String     @unique
  passwordHash      String
  fullName          String
  avatar            String?
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(PENDING_VERIFICATION)
  isPhoneVerified   Boolean    @default(false)
  isEmailVerified   Boolean    @default(false)
  fcmToken          String?
  lastLoginAt       DateTime?
  referralCode      String?    @unique
  referredBy        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  customer          Customer?
  seller            Seller?
  rider             Rider?
  wallet            Wallet?
  otpVerifications  OtpVerification[]
  notifications     Notification[]
  supportTickets    SupportTicket[]
  adminLogs         AdminLog[]
  userCoupons       UserCoupon[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([referralCode])
  @@map("users")
}

model OtpVerification {
  id          String   @id @default(uuid())
  userId      String
  phone       String
  otp         String
  sessionInfo String?  // Firebase sessionInfo for phone auth
  purpose     OtpPurpose
  isUsed      Boolean  @default(false)
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@map("refresh_tokens")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(uuid())
  userId          String    @unique
  dateOfBirth     DateTime?
  gender          String?
  preferredLang   String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  addresses       Address[]
  orders          Order[]
  simOrders       SimOrder[]
  topupOrders     TopupOrder[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  cartItems       CartItem[]

  @@map("customers")
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  label        String   @default("Home")
  fullName     String?
  phone        String?
  addressLine1 String   @default("")
  addressLine2 String?
  city         String   @default("")
  district     String?
  postalCode   String?
  lat          Float?
  lng          Float?
  isDefault             Boolean  @default(false)
  deliveryGeneral       String?
  deliveryLockerCode    String?
  deliveryOtherNote     String?
  gateCode              String?
  deliveryDawn          String?
  deliveryDawnSub       String?
  deliveryDawnCode      String?
  deliveryDawnNotify    String?
  deliveryDawnOtherNote String?
  createdAt             DateTime @default(now())

  customer     Customer @relation(fields: [customerId], references: [id])
  orders       Order[]

  @@map("addresses")
}

model Wallet {
  id           String          @id @default(uuid())
  userId       String          @unique
  balance      Float           @default(0)
  currency     String          @default("KRW")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String              @id @default(uuid())
  walletId    String
  type        WalletTxType
  amount      Float
  balance     Float
  reference   String?
  description String?
  createdAt   DateTime            @default(now())

  wallet      Wallet              @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("wallet_transactions")
}

// ─── Seller ──────────────────────────────────────────────────────────────────

model Seller {
  id                  String       @id @default(uuid())
  userId              String       @unique
  storeName           String
  storeSlug           String       @unique
  storeDescription    String?
  storeLogo           String?
  storeBanner         String?
  businessRegNumber   String?
  address             String?
  detailAddress       String?
  businessDocUrl      String?
  idDocUrl            String?
  bankName            String?
  accountNumber       String?
  accountHolderName   String?
  commissionRate      Float        @default(10)
  sellerStatus        SellerStatus @default(PENDING)
  totalEarnings       Float        @default(0)
  pendingPayout       Float        @default(0)
  rating              Float        @default(0)
  totalSales          Int          @default(0)
  rejectionReason     String?
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id])
  products            Product[]
  orderItems          OrderItem[]
  payouts             SellerPayout[]
  commissions         Commission[]

  @@index([storeSlug])
  @@map("sellers")
}

model SellerPayout {
  id              String       @id @default(uuid())
  sellerId        String
  amount          Float
  commission      Float
  netAmount       Float
  bankName        String
  accountNumber   String
  accountHolder   String
  status          PayoutStatus @default(PENDING)
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())

  seller          Seller       @relation(fields: [sellerId], references: [id])

  @@map("seller_payouts")
}

// ─── Rider ───────────────────────────────────────────────────────────────────

model Rider {
  id                String      @id @default(uuid())
  userId            String      @unique
  vehicleType       String
  vehicleNumber     String
  licenseNumber     String
  licenseDocUrl     String?
  idDocUrl          String?
  riderStatus       RiderStatus @default(OFFLINE)
  currentLat        Float?
  currentLng        Float?
  totalDeliveries   Int         @default(0)
  totalEarnings     Float       @default(0)
  rating            Float       @default(0)
  isOnline          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id])
  deliveries        DeliveryAssignment[]
  trackingPoints    DeliveryTracking[]

  @@map("riders")
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String
  nameKr      String?
  slug        String     @unique
  icon        String?
  image       String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]

  @@index([slug])
  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id                   String        @id @default(uuid())
  sellerId             String
  categoryId           String
  name                 String
  nameKr               String?
  description          String
  price                Float
  discountPrice        Float?
  discountPercent      Float?
  stock                Int           @default(0)
  unit                 String        @default("pc")
  sku                  String?       @unique
  weight               String?
  brand                String?
  countryOfOrigin      String?
  status               ProductStatus @default(ACTIVE)
  rating               Float         @default(0)
  reviewCount          Int           @default(0)
  isDeliveryAvailable  Boolean       @default(true)
  deliveryFee          Float         @default(0)
  minOrderQty          Int           @default(1)
  maxOrderQty          Int?
  tags                 String[]
  isFeatured           Boolean       @default(false)
  viewCount            Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  seller               Seller        @relation(fields: [sellerId], references: [id])
  category             Category      @relation(fields: [categoryId], references: [id])
  images               ProductImage[]
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]
  reviews              Review[]
  cartItems            CartItem[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("wishlists")
}

model CartItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("carts")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerId      String
  addressId       String?
  couponId        String?
  status          OrderStatus   @default(PENDING)
  subtotal        Float
  deliveryFee     Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  total           Float
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?
  estimatedAt     DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  isAdminTest     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id])
  address         Address?      @relation(fields: [addressId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  delivery        DeliveryAssignment?
  commissions     Commission[]
  statusHistory   OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  sellerId       String
  productName    String
  productImage   String?
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  discountAmount Float    @default(0)
  notes          String?

  order          Order    @relation(fields: [orderId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  seller         Seller   @relation(fields: [sellerId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

model Review {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  orderId    String?
  rating     Int
  comment    String?
  images     String[]
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId, orderId])
  @@map("reviews")
}

// ─── SIM Cards ───────────────────────────────────────────────────────────────

model SimNumber {
  id                    String     @id @default(uuid())
  fullNumber            String     @unique
  maskedNumber          String
  lastFourDigits        String
  carrier               SimCarrier
  simType               SimType
  price                 Float
  status                SimStatus  @default(AVAILABLE)
  activationRequired    Boolean    @default(true)
  requiresIdVerification Boolean   @default(true)
  customerChoosesLastFour Boolean  @default(false)
  numberPrefix          String?
  notes                 String?
  addedBy               String?
  batchId               String?
  reservedUntil         DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  simOrders             SimOrder[]

  @@index([lastFourDigits])
  @@index([status])
  @@index([carrier])
  @@index([numberPrefix])
  @@map("sim_numbers")
}

model SimOrder {
  id               String     @id @default(uuid())
  orderNumber      String     @unique
  customerId       String
  simNumberId      String
  status           SimStatus  @default(PENDING)
  idDocumentUrl    String?
  idDocumentType   String?
  idVerified       Boolean    @default(false)
  deliveryAddressId String?
  riderId          String?
  reservedAt       DateTime?
  confirmedAt      DateTime?
  processingAt     DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  adminNotes       String?
  price            Float
  paymentStatus    PaymentStatus @default(PENDING)
  isAdminTest      Boolean       @default(false)
  chosenLastFour   String?       // for prefix-mode numbers: the last 4 digits customer chose
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer         Customer   @relation(fields: [customerId], references: [id])
  simNumber        SimNumber  @relation(fields: [simNumberId], references: [id])
  payment          Payment[]
  statusHistory    SimOrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@map("sim_orders")
}

model SimOrderStatusHistory {
  id         String    @id @default(uuid())
  simOrderId String
  status     SimStatus
  notes      String?
  createdBy  String?
  createdAt  DateTime  @default(now())

  simOrder   SimOrder  @relation(fields: [simOrderId], references: [id])

  @@map("sim_order_status_history")
}

// ─── Top-Up ──────────────────────────────────────────────────────────────────

model TopupOrder {
  id                String       @id @default(uuid())
  orderNumber       String       @unique
  customerId        String
  providerId        String?
  topupType         TopupType
  countryCode       String
  countryName       String
  phoneNumber       String
  operator          String?
  amount            Float
  currency          String       @default("KRW")
  exchangeRate      Float?
  serviceFee        Float        @default(0)
  totalAmount       Float
  status            TopupStatus  @default(PENDING)
  providerReference String?
  failureReason     String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer          Customer     @relation(fields: [customerId], references: [id])
  provider          TopupProvider? @relation(fields: [providerId], references: [id])
  payments          Payment[]

  @@index([customerId])
  @@index([status])
  @@map("topup_orders")
}

model TopupProvider {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  countries   String[]
  apiEndpoint String?
  apiKey      String?
  isActive    Boolean  @default(true)
  minAmount   Float    @default(1000)
  maxAmount   Float    @default(100000)
  serviceFee  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topupOrders TopupOrder[]

  @@map("topup_providers")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id               String        @id @default(uuid())
  orderId          String?
  simOrderId       String?
  topupOrderId     String?
  customerId       String?
  amount           Float
  currency         String        @default("KRW")
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  transactionId    String?
  gatewayPaymentId String?
  gatewayResponse  Json?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  order            Order?        @relation(fields: [orderId], references: [id])
  simOrder         SimOrder?     @relation(fields: [simOrderId], references: [id])
  topupOrder       TopupOrder?   @relation(fields: [topupOrderId], references: [id])
  refunds          Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String       @id @default(uuid())
  orderId     String?
  paymentId   String?
  customerId  String?
  amount      Float
  reason      String
  status      RefundStatus @default(PENDING)
  adminNotes  String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  order       Order?       @relation(fields: [orderId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Commission {
  id          String   @id @default(uuid())
  orderId     String
  sellerId    String
  orderAmount Float
  rate        Float
  amount      Float
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  seller      Seller   @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("commissions")
}

// ─── Delivery ────────────────────────────────────────────────────────────────

model DeliveryAssignment {
  id                 String         @id @default(uuid())
  orderId            String         @unique
  riderId            String
  status             DeliveryStatus @default(ASSIGNED)
  pickupLat          Float?
  pickupLng          Float?
  pickupAddress      String?
  dropoffLat         Float?
  dropoffLng         Float?
  dropoffAddress     String?
  estimatedPickup    DateTime?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  deliveryProofUrl   String?
  deliveryOtp        String?
  riderNotes         String?
  distance           Float?
  deliveryFee        Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order              Order          @relation(fields: [orderId], references: [id])
  rider              Rider          @relation(fields: [riderId], references: [id])
  trackingPoints     DeliveryTracking[]

  @@index([riderId])
  @@map("delivery_assignments")
}

model DeliveryTracking {
  id           String   @id @default(uuid())
  assignmentId String
  riderId      String
  lat          Float
  lng          Float
  speed        Float?
  heading      Float?
  accuracy     Float?
  recordedAt   DateTime @default(now())

  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id])
  rider        Rider              @relation(fields: [riderId], references: [id])

  @@index([assignmentId])
  @@index([riderId])
  @@map("delivery_tracking")
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model Coupon {
  id              String          @id @default(uuid())
  code            String          @unique
  title           String
  description     String?
  type            CouponType
  category        CouponCategory  @default(MANUAL)
  value           Float
  minOrderAmount  Float           @default(0)
  maxDiscount     Float?
  usageLimit      Int?
  usedCount       Int             @default(0)
  perUserLimit    Int             @default(1)
  isActive        Boolean         @default(true)
  autoAssign      Boolean         @default(false)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orders          Order[]
  userCoupons     UserCoupon[]

  @@index([code])
  @@index([category])
  @@index([isActive])
  @@map("coupons")
}

// Per-user coupon wallet: links a Coupon to a specific User
model UserCoupon {
  id          String          @id @default(uuid())
  userId      String
  couponId    String
  isUsed      Boolean         @default(false)
  usedAt      DateTime?
  usedOrderId String?
  source      CouponCategory  @default(MANUAL)
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id])
  coupon      Coupon          @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
  @@map("user_coupons")
}

model Banner {
  id         String      @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  linkType   BannerLink  @default(NONE)
  linkValue  String?
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime    @default(now())

  @@map("banners")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String        @id @default(uuid())
  userId      String
  subject     String
  message     String
  category    TicketCategory
  status      TicketStatus  @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  replies     TicketReply[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id])

  @@map("ticket_replies")
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  module     String
  targetId   String?
  targetType String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@map("admin_logs")
}

model AppSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

model DeliveryZone {
  id          String   @id @default(uuid())
  name        String
  description String?
  polygon     Json
  deliveryFee Float    @default(3000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("delivery_zones")
}

// ─── Exchange Rates ──────────────────────────────────────────────────────────

model ExchangeRateProvider {
  id                     String         @id @default(uuid())
  companyName            String
  slug                   String         @unique
  logoUrl                String?
  country                String         @default("KR")
  officialWebsite        String?
  appDeepLink            String?
  supportedSendCurrencies String[]      @default(["KRW"])
  supportedRecvCurrencies String[]      @default([])
  status                 ProviderStatus @default(ACTIVE)
  fetchMethod            FetchMethod    @default(MANUAL)
  scraperKey             String?
  sourceUrl              String?
  isVerified             Boolean        @default(false)
  isFeatured             Boolean        @default(false)
  priority               Int            @default(50)
  transferTime           String?
  minAmount              Float?
  maxAmount              Float?
  rateSpreadPercent      Float          @default(0)
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  rates                  ExchangeRate[]
  updateLogs             RateUpdateLog[]

  @@index([slug])
  @@index([status])
  @@map("exchange_rate_providers")
}

model ExchangeRate {
  id           String               @id @default(uuid())
  providerId   String
  sendCurrency String
  recvCurrency String
  rate         Float
  transferFee  Float                @default(0)
  isBestRate   Boolean              @default(false)
  isStale      Boolean              @default(false)
  rateSource   String               @default("manual")
  lastUpdated  DateTime             @default(now())
  createdAt    DateTime             @default(now())

  provider     ExchangeRateProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, sendCurrency, recvCurrency])
  @@index([sendCurrency, recvCurrency])
  @@index([providerId])
  @@map("exchange_rates")
}

model RateUpdateLog {
  id           String               @id @default(uuid())
  providerId   String
  success      Boolean
  fetchMethod  FetchMethod
  ratesUpdated Int                  @default(0)
  errorMessage String?
