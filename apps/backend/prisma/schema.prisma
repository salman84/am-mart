// ═══════════════════════════════════════════════════════════════════════════════
// ██  PARCEL DELIVERY SYSTEM — Warehouse, Routes, Packages, Proofs, Returns  ██
// ═══════════════════════════════════════════════════════════════════════════════

// ── Fulfillment Center Management ────────────────────────────────────────────

model FulfillmentCenter {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  address             String
  city                String
  district            String?
  postalCode          String?
  lat                 Float?
  lng                 Float?
  phone               String?
  email               String?
  managerUserId       String?
  capacity            Int      @default(10000)
  currentOccupancy    Int      @default(0)
  isActive            Boolean  @default(true)
  operatingHoursStart String?
  operatingHoursEnd   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  bins                WarehouseBin[]
  inventory           WarehouseInventory[]
  incomingTransfers   WarehouseTransfer[]  @relation("TransferDestination")
  outgoingTransfers   WarehouseTransfer[]  @relation("TransferOrigin")
  shipments           Shipment[]
  zones               DeliveryZone[]
  routes              DeliveryRoute[]
  orders              Order[]
  packages            Package[]
  driverShifts        DriverShift[]

  @@index([code])
  @@index([isActive])
  @@map("fulfillment_centers")
}

model WarehouseBin {
  id                  String   @id @default(uuid())
  fulfillmentCenterId String
  binCode             String
  section             String?
  aisle               String?
  shelf               String?
  position            String?
  capacity            Int      @default(100)
  currentOccupancy    Int      @default(0)
  binType             WarehouseBinType @default(STANDARD)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  fulfillmentCenter   FulfillmentCenter @relation(fields: [fulfillmentCenterId], references: [id])
  inventory           WarehouseInventory[]

  @@unique([fulfillmentCenterId, binCode])
  @@index([fulfillmentCenterId])
  @@map("warehouse_bins")
}

model WarehouseInventory {
  id                  String   @id @default(uuid())
  fulfillmentCenterId String
  binId               String?
  productId           String
  sellerId            String
  quantity            Int      @default(0)
  reservedQuantity    Int      @default(0)
  damagedQuantity     Int      @default(0)
  lastStockCheck      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  fulfillmentCenter   FulfillmentCenter @relation(fields: [fulfillmentCenterId], references: [id])
  bin                 WarehouseBin?     @relation(fields: [binId], references: [id])

  @@unique([fulfillmentCenterId, productId, sellerId])
  @@index([fulfillmentCenterId])
  @@index([productId])
  @@index([sellerId])
  @@map("warehouse_inventory")
}

model WarehouseTransfer {
  id                      String   @id @default(uuid())
  transferNumber          String   @unique
  originType              TransferOriginType @default(SELLER)
  originFulfillmentId     String?
  destinationFulfillmentId String
  sellerId                String?
  status                  TransferStatus @default(REQUESTED)
  requestedBy             String?
  approvedBy              String?
  receivedBy              String?
  totalItems              Int      @default(0)
  totalReceived           Int      @default(0)
  notes                   String?
  requestedAt             DateTime @default(now())
  approvedAt              DateTime?
  shippedAt               DateTime?
  receivedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  originFulfillment       FulfillmentCenter? @relation("TransferOrigin", fields: [originFulfillmentId], references: [id])
  destinationFulfillment  FulfillmentCenter  @relation("TransferDestination", fields: [destinationFulfillmentId], references: [id])
  items                   WarehouseTransferItem[]

  @@index([sellerId])
  @@index([status])
  @@index([destinationFulfillmentId])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id                String   @id @default(uuid())
  transferId        String
  productId         String
  expectedQuantity  Int
  receivedQuantity  Int      @default(0)
  damagedQuantity   Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  transfer          WarehouseTransfer @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("warehouse_transfer_items")
}

// ── Package & Tracking ───────────────────────────────────────────────────────

model Package {
  id                  String        @id @default(uuid())
  shipmentId          String
  trackingNumber      String        @unique
  barcode             String?       @unique
  qrCode              String?
  status              PackageStatus @default(CREATED)
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  description         String?
  fulfillmentCenterId String?
  binId               String?
  pickedBy            String?
  pickedAt            DateTime?
  packedBy            String?
  packedAt            DateTime?
  labelGeneratedAt    DateTime?
  sortedAt            DateTime?
  sortZone            String?
  deliveryAttempts    Int           @default(0)
  maxAttempts         Int           @default(3)
  currentAttempt      Int           @default(0)
  specialInstructions String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  shipment            Shipment      @relation(fields: [shipmentId], references: [id])
  fulfillmentCenter   FulfillmentCenter? @relation(fields: [fulfillmentCenterId], references: [id])
  scans               PackageScan[]
  routeStop           RouteStop?
  deliveryProof       DeliveryProof?
  failedDeliveries    FailedDelivery[]

  @@index([shipmentId])
  @@index([trackingNumber])
  @@index([status])
  @@index([fulfillmentCenterId])
  @@map("packages")
}

model PackageScan {
  id          String   @id @default(uuid())
  packageId   String
  scanType    ScanType
  scannedBy   String
  deviceId    String?
  lat         Float?
  lng         Float?
  locationName String?
  notes       String?
  scannedAt   DateTime @default(now())
  package     Package  @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@index([scanType])
  @@index([scannedAt])
  @@map("package_scans")
}

// ── Route & Delivery Management ──────────────────────────────────────────────

model DeliveryRoute {
  id                  String      @id @default(uuid())
  routeNumber         String      @unique
  riderId             String?
  fulfillmentCenterId String?
  zoneId              String?
  status              RouteStatus @default(PLANNED)
  plannedDate         DateTime
  startedAt           DateTime?
  completedAt         DateTime?
  totalStops          Int         @default(0)
  completedStops      Int         @default(0)
  failedStops         Int         @default(0)
  totalDistance        Float?
  estimatedDuration   Int?
  actualDuration      Int?
  optimizedOrder      Json?
  notes               String?
  createdBy           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  rider               Rider?              @relation(fields: [riderId], references: [id])
  fulfillmentCenter   FulfillmentCenter?  @relation(fields: [fulfillmentCenterId], references: [id])
  zone                DeliveryZone?       @relation(fields: [zoneId], references: [id])
  stops               RouteStop[]

  @@index([riderId])
  @@index([fulfillmentCenterId])
  @@index([zoneId])
  @@index([status])
  @@index([plannedDate])
  @@map("delivery_routes")
}

model RouteStop {
  id                  String         @id @default(uuid())
  routeId             String
  packageId           String         @unique
  stopOrder           Int
  status              RouteStopStatus @default(PENDING)
  customerName        String?
  customerPhone       String?
  addressLine1        String
  addressLine2        String?
  city                String?
  district            String?
  postalCode          String?
  lat                 Float?
  lng                 Float?
  deliveryNotes       String?
  zoneId              String?
  estimatedArrival    DateTime?
  actualArrival       DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  attemptNumber       Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  route               DeliveryRoute  @relation(fields: [routeId], references: [id])
  package             Package        @relation(fields: [packageId], references: [id])
  zone                DeliveryZone?  @relation(fields: [zoneId], references: [id])

  @@index([routeId])
  @@index([status])
  @@map("route_stops")
}

// ── Proof of Delivery ────────────────────────────────────────────────────────

model DeliveryProof {
  id            String    @id @default(uuid())
  packageId     String    @unique
  riderId       String
  proofType     ProofType
  photoUrl      String?
  signatureUrl  String?
  otp           String?
  otpVerified   Boolean   @default(false)
  gpsLat        Float?
  gpsLng        Float?
  gpsAccuracy   Float?
  deviceId      String?
  deliveredAt   DateTime  @default(now())
  recipientName String?
  safePlaceDesc String?
  driverNotes   String?
  createdAt     DateTime  @default(now())
  package       Package   @relation(fields: [packageId], references: [id])
  rider         Rider     @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([deliveredAt])
  @@map("delivery_proofs")
}

model FailedDelivery {
  id              String              @id @default(uuid())
  packageId       String
  riderId         String
  attemptNumber   Int
  reason          FailedDeliveryReason
  reasonNotes     String?
  photoUrl        String?
  gpsLat          Float?
  gpsLng          Float?
  deviceId        String?
  rescheduledDate DateTime?
  returnToWarehouse Boolean           @default(false)
  createdAt       DateTime            @default(now())
  package         Package             @relation(fields: [packageId], references: [id])
  rider           Rider               @relation(fields: [riderId], references: [id])

  @@index([packageId])
  @@index([riderId])
  @@index([reason])
  @@map("failed_deliveries")
}

// ── Driver Management ────────────────────────────────────────────────────────

model DeliveryPartner {
  id                String   @id @default(uuid())
  companyName       String
  companyCode       String   @unique
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  address           String?
  businessRegNumber String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  commissionRate    Float    @default(0)
  perDeliveryFee    Float    @default(0)
  isActive          Boolean  @default(true)
  fleetSize         Int      @default(0)
  totalDeliveries   Int      @default(0)
  totalSettled      Float    @default(0)
  pendingSettlement Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  riders            Rider[]
  settlements       DriverEarningsSettlement[]

  @@index([companyCode])
  @@index([isActive])
  @@map("delivery_partners")
}

model DriverDocument {
  id            String             @id @default(uuid())
  riderId       String
  documentType  DriverDocumentType
  documentUrl   String
  fileName      String?
  status        DriverDocStatus    @default(PENDING)
  expiresAt     DateTime?
  verifiedBy    String?
  verifiedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  rider         Rider              @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([documentType])
  @@index([status])
  @@map("driver_documents")
}

model DriverShift {
  id                  String    @id @default(uuid())
  name                String
  fulfillmentCenterId String?
  startTime           String
  endTime             String
  maxDrivers          Int       @default(10)
  isActive            Boolean   @default(true)
  daysOfWeek          Int[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  fulfillmentCenter   FulfillmentCenter? @relation(fields: [fulfillmentCenterId], references: [id])
  assignments         DriverShiftAssignment[]

  @@index([fulfillmentCenterId])
  @@index([isActive])
  @@map("driver_shifts")
}

model DriverShiftAssignment {
  id        String   @id @default(uuid())
  shiftId   String
  riderId   String
  date      DateTime
  status    ShiftAssignmentStatus @default(SCHEDULED)
  clockInAt  DateTime?
  clockOutAt DateTime?
  createdAt DateTime @default(now())
  shift     DriverShift @relation(fields: [shiftId], references: [id])
  rider     Rider       @relation(fields: [riderId], references: [id])

  @@unique([shiftId, riderId, date])
  @@index([riderId])
  @@index([date])
  @@map("driver_shift_assignments")
}

model DriverAttendance {
  id        String   @id @default(uuid())
  riderId   String
  date      DateTime
  clockIn   DateTime?
  clockOut  DateTime?
  hoursWorked Float?
  status    AttendanceStatus @default(ABSENT)
  notes     String?
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id])

  @@unique([riderId, date])
  @@index([riderId])
  @@index([date])
  @@map("driver_attendance")
}

// ── Customer Delivery Features ───────────────────────────────────────────────

model DeliveryTimeSlot {
  id          String   @id @default(uuid())
  name        String
  startTime   String
  endTime     String
  zoneId      String?
  maxOrders   Int      @default(50)
  currentLoad Int      @default(0)
  surcharge   Float    @default(0)
  isExpress   Boolean  @default(false)
  isActive    Boolean  @default(true)
  daysOfWeek  Int[]
  cutoffHours Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  zone        DeliveryZone? @relation(fields: [zoneId], references: [id])
  orders      Order[]

  @@index([zoneId])
  @@index([isActive])
  @@map("delivery_time_slots")
}

model DeliveryRating {
  id          String   @id @default(uuid())
  orderId     String   @unique
  riderId     String
  customerId  String
  rating      Int
  comment     String?
  tags        String[]
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  rider       Rider    @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([customerId])
  @@map("delivery_ratings")
}

// ── Finance & Settlement ─────────────────────────────────────────────────────

model DeliveryFeeRule {
  id                    String   @id @default(uuid())
  name                  String
  zoneId                String?
  feeType               DeliveryFeeType @default(FLAT)
  baseFee               Float    @default(0)
  perKgFee              Float    @default(0)
  perKmFee              Float    @default(0)
  freeShippingThreshold Float?
  expressMultiplier     Float    @default(1.5)
  surgeMultiplier       Float    @default(1.0)
  minFee                Float    @default(0)
  maxFee                Float?
  priority              Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  zone                  DeliveryZone? @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@index([isActive, priority])
  @@map("delivery_fee_rules")
}

model DriverEarningsSettlement {
  id              String   @id @default(uuid())
  riderId         String
  partnerId       String?
  periodStart     DateTime
  periodEnd       DateTime
  totalDeliveries Int      @default(0)
  totalEarnings   Float    @default(0)
  bonuses         Float    @default(0)
  deductions      Float    @default(0)
  netAmount       Float    @default(0)
  codCollected    Float    @default(0)
  codSettled      Float    @default(0)
  status          DriverSettlementStatus @default(PENDING)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rider           Rider           @relation(fields: [riderId], references: [id])
  partner         DeliveryPartner? @relation(fields: [partnerId], references: [id])

  @@index([riderId])
  @@index([partnerId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("driver_earnings_settlements")
}

// ── Reverse Logistics ────────────────────────────────────────────────────────

model ReturnPickup {
  id              String           @id @default(uuid())
  returnRequestId String           @unique
  riderId         String?
  status          ReturnPickupStatus @default(PENDING)
  scheduledDate   DateTime?
  pickupAddress   String?
  pickupLat       Float?
  pickupLng       Float?
  pickedUpAt      DateTime?
  returnedToWarehouseAt DateTime?
  proofPhotoUrl   String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id])
  rider           Rider?           @relation(fields: [riderId], references: [id])

  @@index([riderId])
  @@index([status])
  @@map("return_pickups")
}

model ReturnInspection {
  id              String           @id @default(uuid())
  returnRequestId String           @unique
  inspectedBy     String?
  condition       InspectionCondition @default(PENDING)
  notes           String?
  images          String[]
  refundApproved  Boolean          @default(false)
  refundAmount    Float?
  restockApproved Boolean          @default(false)
  inspectedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id])

  @@index([condition])
  @@map("return_inspections")
}

