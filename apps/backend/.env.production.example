# ─────────────────────────────────────────────────────────────────
#  AM Mart Backend — Production Environment Variables
#  Copy these into the Render dashboard → Environment tab
# ─────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Database (Neon) ───────────────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
# Use the "pooled" connection string (ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ammart?sslmode=require

# ── JWT Secrets ───────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_64_CHAR_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Firebase (Phone OTP + Push Notifications) ────────────────────
FIREBASE_WEB_API_KEY=AIzaSyDodj0NvApuNGGFmSwvBmVxsziEmqeucqk
FIREBASE_PROJECT_ID=am-mart-267d8
# From Firebase → Project Settings → Service Accounts → Generate private key
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@am-mart-267d8.iam.gserviceaccount.com

# ── Cloudinary ────────────────────────────────────────────────────
# Get from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── App URLs (fill after first deploy) ───────────────────────────
# Your Render service URL (e.g. https://ammart-backend.onrender.com)
APP_URL=https://ammart-backend.onrender.com
# Your Vercel admin URL (e.g. https://ammart-admin.vercel.app)
FRONTEND_URL=https://ammart-admin.vercel.app

# ── Admin Seed Account ────────────────────────────────────────────
ADMIN_EMAIL=admin@ammart.com
ADMIN_PASSWORD=ChangeThisStrongPassword!123
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_ENCRYPTION_KEY

# ── Rate Limiting ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=200
